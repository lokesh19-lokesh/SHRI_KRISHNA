# ======================================================================
# Shri Krishna Dental Hospital - Production Apache .htaccess Configuration
# Domain: https://shrikrishnadental.com/
# Features: Clean URLs (Hide .html), HTTPS Enforcement, Gzip, Browser Caching, Security Headers
# ======================================================================

# ----------------------------------------------------------------------
# 1. REWRITE ENGINE & CLEAN URLS (REMOVE .HTML)
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Redirect index.html or index to root /
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index(\.html)?\ HTTP/
  RewriteRule ^index(\.html)?$ / [R=301,L]

  # 301 Redirect direct browser requests with .html extension to clean URL (e.g., /about.html -> /about)
  # Exempts POST requests so forms continue working seamlessly
  RewriteCond %{REQUEST_METHOD} !POST
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteRule ^ %1 [R=301,L,NE]

  # Silently serve the corresponding .html file when a clean URL is requested (e.g. /about -> serves /about.html)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L,QSA]
</IfModule>

# ----------------------------------------------------------------------
# 2. SECURITY HEADERS
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
  # Prevent MIME-sniffing
  Header set X-Content-Type-Options "nosniff"
  
  # Prevent Clickjacking (allow frames only from same origin)
  Header set X-Frame-Options "SAMEORIGIN"
  
  # Enable XSS Filter in legacy browsers
  Header set X-XSS-Protection "1; mode=block"
  
  # Referrer Policy
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  
  # Permissions Policy
  Header set Permissions-Policy "geolocation=(self), microphone=(), camera=()"
</IfModule>

# ----------------------------------------------------------------------
# 3. GZIP / BROTLI COMPRESSION (FASTER PAGE LOAD)
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
  AddOutputFilterByType DEFLATE application/xml application/xhtml+xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml image/x-icon
</IfModule>

# ----------------------------------------------------------------------
# 4. BROWSER CACHING / EXPIRES HEADERS
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # Images and Media (1 Year)
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # CSS and JavaScript (1 Month)
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"

  # Web Fonts (1 Year)
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"

  # HTML documents (1 Hour for freshness)
  ExpiresByType text/html "access plus 1 hour"
</IfModule>

# ----------------------------------------------------------------------
# 5. ERROR PAGES & DIRECTORY BROWSING
# ----------------------------------------------------------------------
# Prevent directory listing
Options -Indexes

# Protect sensitive database & log files
<FilesMatch "\.(csv|log|json|txt|env|ini)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Allow public access to llms.txt, llms-full.txt, and robots.txt
<FilesMatch "^(robots\.txt|llms\.txt|llms-full\.txt)$">
  <IfModule mod_authz_core.c>
    Require all granted
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Allow from all
  </IfModule>
</FilesMatch>

# Custom 404 Fallback
ErrorDocument 404 /index.html
